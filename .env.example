# Copia questo file in ".env" per lo sviluppo locale (non committarlo mai!)
# Su Render, imposta queste stesse chiavi nella sezione "Environment" del servizio.

TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARCGIS_CLIENT_ID=il_tuo_client_id
ARCGIS_CLIENT_SECRET=il_tuo_client_secret
ARCGIS_FEATURE_LAYER_URL=https://services.arcgis.com/XXXXX/arcgis/rest/services/Posizione_partenze2_PT/FeatureServer/0
WEBHOOK_SECRET=una_stringa_casuale_lunga_a_tua_scelta

# --- Sincronizzatore interventi da XML Oracle (sync_interventi.py) ---
# Cartella in cui il software di gestione interventi rigenera i due XML
XML_CARTELLA=C:\percorso\della\cartella\xml
ARCGIS_INTERVENTI_LAYER_URL=https://services.arcgis.com/XXXXX/arcgis/rest/services/Interventi_chiamate_PT/FeatureServer/0
# Ogni quanti secondi controllare se gli XML sono cambiati
INTERVALLO_SECONDI=20
# Nomi dei file, da cambiare solo se il software li chiama diversamente
#XML_FILE_CHIAMATE=chiamate_interventi.XML
#XML_FILE_INTERVENTI=interventi.XML
# Codici STATUS che indicano un intervento concluso, separati da virgola.
# Valvola manuale per un futuro codice STATUS confermato come chiusura
# definitiva: la chiusura si riconosce comunque quando l'intervento sparisce
# del tutto dall'XML, questa resta un'eccezione aggiuntiva, oggi non serve.
#STATI_CHIUSI=C,X
# Layer poligonale delle zone di competenza (facoltativo): se non impostato,
# il campo Zona_competenza resta vuoto ovunque, nessun errore.
#ARCGIS_ZONA_LAYER_URL=https://services.arcgis.com/XXXXX/arcgis/rest/services/COMPETENZE_PT/FeatureServer/0
